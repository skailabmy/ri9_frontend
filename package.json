{
  "name": "ri9-frontend",
  "version": "1.0.0",
  "description": "RI9 Quiz Drill — Capacitor + Vite + TypeScript + Zustand (web prototype from the Flutter dumo_drill migration)",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0 --port=8100",
    "build": "vite build",
    "preview": "vite preview --host=0.0.0.0 --port=8100",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
