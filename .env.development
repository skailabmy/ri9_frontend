# Vite env file — loaded in dev (`npm run dev`) and when building with --mode development.
# Only variables prefixed with VITE_ are exposed to the app bundle.
# Local overrides (secrets, personal URLs) go in .env.local — git-ignored.

# Staging (from dumo_drill/.env)
VITE_API_BASE_URL=https://07ffa41d-877a-4686-adad-34c8e11f5dde-00-31g5s05smz7ip.pike.replit.dev
VITE_DUMO_BASE_URL=https://dev.datadumoserve.com

# API logger: debug | info | warn | error | off
# 'debug' also logs request/response bodies.
VITE_API_LOG_LEVEL=debug
