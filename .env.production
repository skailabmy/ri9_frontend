# Vite env file — used for production builds (`npm run build`).
# Only variables prefixed with VITE_ are exposed to the app bundle.

# Production (from dumo_drill/.env)
VITE_API_BASE_URL=https://d17boou8pmpip2.cloudfront.net
VITE_DUMO_BASE_URL=https://datadumoserve.com

# API logger: debug | info | warn | error | off
# 'debug' also logs request/response bodies.
VITE_API_LOG_LEVEL=info
